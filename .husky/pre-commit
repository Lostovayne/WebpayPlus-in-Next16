#!/usr/bin/env sh
set -e

# Only lint source files
STAGED=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx|js|jsx|mjs|cjs)$' || true)

if [ -n "$STAGED" ]; then
  echo "$STAGED" | xargs bunx eslint --fix
  git add $STAGED
fi

# Typecheck (fail on any TS error)
bunx tsc --noEmit -p tsconfig.ci.json

# Run full test suite
bun run test:run
